FROM rust:1.89-bookworm@sha256:948f9b08a66e7fe01b03a98ef1c7568292e07ec2e4fe90d88c07bb14563c84ff
# Cross checks establish Windows compilation, never native ACL/runtime acceptance.
RUN apt-get update && apt-get install -y --no-install-recommends gcc-mingw-w64-x86-64 cmake && rm -rf /var/lib/apt/lists/*
# The real TLS test fixture also compiles the existing AWS-LC native dependency.
RUN rustup target add x86_64-pc-windows-gnu
RUN rustup component add clippy
WORKDIR /work
