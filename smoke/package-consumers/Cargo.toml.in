[workspace]
members = ["support", "vanilla", "axum-app", "actix-app", "browser-host"]
resolver = "2"

[workspace.dependencies]
debugbundle = { path = "__SDK_PATH__" }
artifact-support = { path = "support" }
serde_json = "1"
tokio = { version = "1.53", features = ["rt-multi-thread", "macros", "net", "sync", "time"] }
axum = { version = "0.8.9", default-features = false, features = ["tokio", "http1", "json", "matched-path"] }
actix-web = { version = "4.19.0", default-features = false, features = ["macros"] }
reqwest = { version = "0.13.5", default-features = false, features = ["rustls", "json"] }
tempfile = "3"
tracing = "0.1.44"
tracing-subscriber = { version = "0.3.23", default-features = false, features = ["registry", "std"] }
anyhow = "1"
thiserror = "2"

[profile.dev]
debug = 0
